generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoleModel {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  permissions  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  columnConfig Json?
  users        User[]
}

model User {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  password          String
  roleId            Int
  locationId        Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  columnPrefs       Json?
  active            Boolean          @default(true)
  auditLogs         AuditLog[]
  despatchNotes     DespatchNote[]   @relation("DespatchNoteUser")
  movements         Movement[]
  notifications     Notification[]
  confirmedRequests ProductRequest[] @relation("RequestConfirmedBy")
  requests          ProductRequest[] @relation("RequestedBy")
  purchaseNotes     PurchaseNote[]   @relation("PurchaseNoteUser")
  quotes            Quote[]
  sales             Sale[]
  location          Location?        @relation(fields: [locationId], references: [id])
  role              RoleModel        @relation(fields: [roleId], references: [id])
}

model Location {
  id            Int              @id @default(autoincrement())
  name          String
  type          LocationType
  address       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  despatchNotes DespatchNote[]   @relation("DespatchNoteDestination")
  inventories   Inventory[]
  movementsFrom Movement[]       @relation("MovementFrom")
  movementsTo   Movement[]       @relation("MovementTo")
  requestsFrom  ProductRequest[] @relation("RequestOrigin")
  requests      ProductRequest[] @relation("RequestDestination")
  purchaseNotes PurchaseNote[]
  quotes        Quote[]          @relation("QuoteLocation")
  salesFrom     Sale[]           @relation("SaleFromLocation")
  users         User[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             Int                @id @default(autoincrement())
  itemCode       String             @unique
  manufacturer   String
  name           String
  brand          String
  model          String
  year           String
  detail         String?
  oemCode        String?
  factoryCode    String?
  image          String?
  price1         Decimal
  price2         Decimal
  wholesalePrice Decimal?
  cost           Decimal?
  categoryId     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  images         String[]           @default([])
  detalles       String?
  unitPrice      Decimal?
  priceHermana   Decimal?
  costs          Cost[]
  despatchItems  DespatchNoteItem[]
  inventories    Inventory[]
  movements      Movement[]
  category       Category?          @relation(fields: [categoryId], references: [id])
  importers      ProductImporter[]
  requests       ProductRequest[]
  purchaseItems  PurchaseNoteItem[]
  quoteItems     QuoteItem[]
  returns        Return[]
  saleItems      SaleItem[]
}

model Inventory {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  stock      Int      @default(0)
  minStock   Int      @default(1)
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id              Int              @id @default(autoincrement())
  saleDate        DateTime         @default(now())
  total           Decimal
  type            SaleType
  userId          Int
  locationId      Int
  customerId      Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  seller          String?
  paraQuien       String?
  lugarEntrega    String?
  datosFactura    String?
  formaPago       String?
  origen          String?
  envioExterior   Boolean          @default(false)
  quienRecoge     String?
  telefono        String?
  note            String?
  status          SaleStatus       @default(PENDIENTE)
  nitName         String?
  telefonoFactura String?
  payments        Payment[]
  requests        ProductRequest[]
  quote           Quote?
  returns         Return[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  location        Location         @relation("SaleFromLocation", fields: [locationId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  items           SaleItem[]
}

model Quote {
  id         Int         @id @default(autoincrement())
  date       DateTime    @default(now())
  total      Decimal
  type       SaleType    @default(NORMAL)
  status     QuoteStatus @default(PENDIENTE)
  clientName String?
  note       String?
  seller     String?
  userId     Int
  locationId Int
  saleId     Int?        @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  location   Location    @relation("QuoteLocation", fields: [locationId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  items      QuoteItem[]

  @@index([date])
  @@index([userId])
  @@index([locationId])
  @@index([status])
  @@index([clientName])
}

model QuoteItem {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  productId Int
  itemCode  String
  name      String
  brand     String?
  quantity  Int
  unitPrice Decimal
  priceTier Int?
  subtotal  Decimal
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model SaleItem {
  id                Int              @id @default(autoincrement())
  saleId            Int
  productId         Int
  quantity          Int
  unitPrice         Decimal
  subtotal          Decimal
  /// Unidades entregadas de verdad al cliente. La diferencia con quantity es
  /// lo que quedo pendiente: se vendio pero aun no hay mercaderia en la tienda
  /// y esta en camino desde el almacen.
  deliveredQuantity Int              @default(0)
  requests          ProductRequest[]
  product           Product          @relation(fields: [productId], references: [id])
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Payment {
  id     Int           @id @default(autoincrement())
  saleId Int
  method PaymentMethod
  amount Decimal
  date   DateTime      @default(now())
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id        Int           @id @default(autoincrement())
  saleId    Int
  productId Int
  reason    String
  quantity  Int
  amount    Decimal
  method    PaymentMethod
  date      DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
  sale      Sale          @relation(fields: [saleId], references: [id])
}

model Movement {
  id             Int             @id @default(autoincrement())
  productId      Int
  fromLocationId Int
  toLocationId   Int
  quantity       Int
  userId         Int
  date           DateTime        @default(now())
  observation    String?
  requestId      Int?
  requester      String?
  fromLocation   Location        @relation("MovementFrom", fields: [fromLocationId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  request        ProductRequest? @relation(fields: [requestId], references: [id])
  toLocation     Location        @relation("MovementTo", fields: [toLocationId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
}

model ProductRequest {
  id             Int              @id @default(autoincrement())
  productId      Int
  quantity       Int
  requestedById  Int
  locationId     Int
  status         RequestStatus    @default(PENDIENTE)
  date           DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  note           String?
  expectedDate   DateTime?
  fromLocationId Int?
  confirmedById  Int?
  confirmedAt    DateTime?
  source         String           @default("MANUAL")
  despatchNoteId Int?
  /// Venta que origino la solicitud cuando se genero por stock faltante al
  /// vender. Permite completar la venta cuando la mercaderia llega.
  saleId         Int?
  saleItemId     Int?
  movements      Movement[]
  confirmedBy    User?            @relation("RequestConfirmedBy", fields: [confirmedById], references: [id])
  despatchNote   DespatchNote?    @relation(fields: [despatchNoteId], references: [id])
  fromLocation   Location?        @relation("RequestOrigin", fields: [fromLocationId], references: [id])
  location       Location         @relation("RequestDestination", fields: [locationId], references: [id])
  product        Product          @relation(fields: [productId], references: [id])
  requestedBy    User             @relation("RequestedBy", fields: [requestedById], references: [id])
  sale           Sale?            @relation(fields: [saleId], references: [id])
  saleItem       SaleItem?        @relation(fields: [saleItemId], references: [id])
  history        RequestHistory[]

  @@index([saleId])
  @@index([saleItemId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
}

model Cost {
  id           Int      @id @default(autoincrement())
  productId    Int
  supplierId   Int
  invoiceUrl   String?
  exchangeRate Decimal?
  costPrice    Decimal
  percentage   Decimal?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
}

model PurchaseNote {
  id              Int                @id @default(autoincrement())
  noteNumber      String             @unique
  date            DateTime           @default(now())
  supplierName    String
  supplierNit     String?
  supplierPhone   String?
  locationId      Int
  fileUrl         String?
  exchangeRate    Decimal?
  expensesPer     Decimal?
  totalUnits      Int                @default(0)
  totalCost       Decimal            @default(0)
  userId          Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  status          PurchaseNoteStatus @default(ACTIVA)
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     Int?
  location        Location           @relation(fields: [locationId], references: [id])
  user            User               @relation("PurchaseNoteUser", fields: [userId], references: [id])
  items           PurchaseNoteItem[]

  @@index([locationId])
}

model PurchaseNoteItem {
  id        Int          @id @default(autoincrement())
  noteId    Int
  productId Int
  quantity  Int
  unitCost  Decimal
  price1    Decimal?
  price2    Decimal?
  disc20    Decimal?
  disc30    Decimal?
  disc40    Decimal?
  disc50    Decimal?
  priceD20  Decimal?
  priceD30  Decimal?
  priceD40  Decimal?
  priceD50  Decimal?
  lineTotal Decimal
  note      PurchaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@index([noteId])
  @@index([productId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DespatchNote {
  id              Int                @id @default(autoincrement())
  noteNumber      String             @unique
  date            DateTime           @default(now())
  userId          Int
  totalUnits      Int                @default(0)
  status          DespatchNoteStatus @default(EMITIDA)
  entregadoA      String?
  entregadoAt     DateTime?
  observacion     String?
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  destinationId   Int?
  destination     Location?          @relation("DespatchNoteDestination", fields: [destinationId], references: [id])
  user            User               @relation("DespatchNoteUser", fields: [userId], references: [id])
  items           DespatchNoteItem[]
  requests        ProductRequest[]
}

model DespatchNoteItem {
  id           Int          @id @default(autoincrement())
  noteId       Int
  productId    Int
  itemCode     String
  name         String
  manufacturer String
  brand        String
  model        String
  locationId   Int
  locationName String
  locationType String
  quantity     Int
  createdAt    DateTime     @default(now())
  note         DespatchNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([noteId])
  @@index([productId])
}

model Manufacturer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Importer {
  id          Int               @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  logo        String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductImporter[]
}

model ProductImporter {
  id         Int      @id @default(autoincrement())
  productId  Int
  importerId Int
  importer   Importer @relation(fields: [importerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, importerId])
}

model RequestHistory {
  id             Int            @id @default(autoincrement())
  requestId      Int
  previousStatus String?
  newStatus      String
  userId         Int
  userRole       String
  createdAt      DateTime       @default(now())
  request        ProductRequest @relation(fields: [requestId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  targetType String
  targetId   Int?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id               Int           @id @default(autoincrement())
  invoiceNumber    String        @unique
  date             DateTime      @default(now())
  supplierId       Int?
  supplierName     String
  manufacturerId   Int?
  manufacturerName String?
  locationId       Int
  locationName     String?
  exchangeRate     Decimal
  expensesPer      Decimal       @default(0)
  marginTienda     Decimal       @default(0)
  dimCode          String?
  fileUrl          String?
  totalUnits       Int           @default(0)
  totalCostUSD     Decimal       @default(0)
  totalCostBS      Decimal       @default(0)
  status           InvoiceStatus @default(ACTIVA)
  inventoryAppliedAt DateTime?
  cancelledAt      DateTime?
  cancelledReason  String?
  createdById      Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  file             InvoiceFile?

  @@index([date])
  @@index([locationId])
}

model InvoiceFile {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @unique
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int?
  factoryCode String?
  itemCode    String?
  name        String
  brand       String
  model       String
  year        String
  oemCode     String?
  detail      String?
  quantity    Int
  costUSD     Decimal
  costBS      Decimal
  costTienda  Decimal
  price1      Decimal?
  price2      Decimal?
  priceMayor  Decimal?
  price10     Decimal?
  price20     Decimal?
  price30     Decimal?
  price40     Decimal?
  price50     Decimal?
  price60     Decimal?
  price70     Decimal?
  price80     Decimal?
  lineTotalBS Decimal?

  @@index([invoiceId])
  @@index([productId])
  @@index([factoryCode])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum QuoteStatus {
  PENDIENTE
  CONVERTIDA
  ANULADA
}

enum Role {
  ADMIN
  TIENDA
  INVENTARIO
}

enum LocationType {
  ALMACEN
  TIENDA
}

enum SaleStatus {
  PENDIENTE
  PAGADO
}

enum SaleType {
  NORMAL
  MAYOR
  DEPARTAMENTAL
}

enum PaymentMethod {
  EFECTIVO
  QR
  TRANSFERENCIA
  CREDITO
}

enum PurchaseNoteStatus {
  ACTIVA
  ANULADA
}

enum DespatchNoteStatus {
  EMITIDA
  ENTREGADA
  ANULADA
}

enum RequestStatus {
  PENDIENTE
  RECIBIDO_POR_INVENTARIO
  PREPARANDO
  ENTREGADO
  RECIBIDO_POR_TIENDA
  CANCELADO
}

enum InvoiceStatus {
  ACTIVA
  ANULADA
}
