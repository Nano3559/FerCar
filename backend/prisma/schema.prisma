generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoleModel {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  permissions  String[]
  columnConfig Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

model User {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  password          String
  roleId            Int
  locationId        Int?
  active            Boolean          @default(true)
  columnPrefs       Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  movements         Movement[]
  requests          ProductRequest[] @relation("RequestedBy")
  confirmedRequests ProductRequest[] @relation("RequestConfirmedBy")
  sales             Sale[]
  location          Location?        @relation(fields: [locationId], references: [id])
  role              RoleModel        @relation(fields: [roleId], references: [id])
  auditLogs         AuditLog[]
  notifications     Notification[]
  purchaseNotes     PurchaseNote[]   @relation("PurchaseNoteUser")
  despatchNotes     DespatchNote[]   @relation("DespatchNoteUser")
  quotes            Quote[]
}

model Location {
  id            Int              @id @default(autoincrement())
  name          String
  type          LocationType
  address       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  inventories   Inventory[]
  movementsFrom Movement[]       @relation("MovementFrom")
  movementsTo   Movement[]       @relation("MovementTo")
  requests      ProductRequest[] @relation("RequestDestination")
  requestsFrom  ProductRequest[] @relation("RequestOrigin")
  despatchNotes DespatchNote[]   @relation("DespatchNoteDestination")
  salesFrom     Sale[]           @relation("SaleFromLocation")
  users         User[]
  purchaseNotes PurchaseNote[]
  quotes        Quote[]          @relation("QuoteLocation")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             Int                @id @default(autoincrement())
  itemCode       String             @unique
  manufacturer   String
  name           String
  brand          String
  model          String
  year           String
  detail         String?
  oemCode        String?
  factoryCode    String?
  image          String?
  images         String[]           @default([])
  price1         Decimal
  price2         Decimal
  wholesalePrice Decimal?
  cost           Decimal?
  unitPrice      Decimal?
  priceHermana   Decimal?
  categoryId     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  detalles       String?
  costs          Cost[]
  inventories    Inventory[]
  movements      Movement[]
  category       Category?          @relation(fields: [categoryId], references: [id])
  importers      ProductImporter[]
  requests       ProductRequest[]
  returns        Return[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseNoteItem[]
  despatchItems  DespatchNoteItem[]
  quoteItems     QuoteItem[]
}

model Inventory {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  stock      Int      @default(0)
  minStock   Int      @default(1)
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  // El indice compuesto sirve para buscar por producto, pero no para agrupar
  // el stock por ubicacion, que es lo que hace el dashboard.
  @@index([locationId])
  @@unique([productId, locationId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id            Int        @id @default(autoincrement())
  saleDate      DateTime   @default(now())
  total         Decimal
  type          SaleType
  userId        Int
  locationId    Int
  customerId    Int?
  seller        String?
  paraQuien     String?
  lugarEntrega  String?
  datosFactura  String?
  formaPago     String?
  origen        String?
  note          String?
  nitName       String?
  telefonoFactura String?
  status        SaleStatus @default(PENDIENTE)
  envioExterior Boolean    @default(false)
  quienRecoge   String?
  telefono      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  payments      Payment[]
  returns       Return[]
  customer      Customer?  @relation(fields: [customerId], references: [id])
  location      Location   @relation("SaleFromLocation", fields: [locationId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  items         SaleItem[]
  quote         Quote?
  /// Solicitudes de reposicion que nacieron de stock faltante en esta venta.
  requests      ProductRequest[]

  // El dashboard resume ventas por fecha, por tienda y por vendedor: cada una
  // se buscaba haciendo un recorrido completo de la tabla.
  @@index([saleDate])
  @@index([locationId])
  @@index([userId])
}

enum QuoteStatus {
  PENDIENTE
  CONVERTIDA
  ANULADA
}

// Una cotizacion queda registrada aunque nunca se cobre. Guarda una copia del
// producto (codigo, nombre, marca) y del precio, para que el documento siga
// siendo reproducible aunque el catalogo cambie despues.
model Quote {
  id         Int         @id @default(autoincrement())
  date       DateTime    @default(now())
  total      Decimal
  type       SaleType    @default(NORMAL)
  status     QuoteStatus @default(PENDIENTE)
  clientName String?
  note       String?
  seller     String?
  userId     Int
  locationId Int
  saleId     Int?        @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  location   Location    @relation("QuoteLocation", fields: [locationId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  items      QuoteItem[]

  @@index([date])
  @@index([userId])
  @@index([locationId])
  @@index([status])
  @@index([clientName])
}

model QuoteItem {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  productId Int
  itemCode  String
  name      String
  brand     String?
  quantity  Int
  unitPrice Decimal
  priceTier Int?
  subtotal  Decimal
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

model SaleItem {
  id       Int @id @default(autoincrement())
  saleId   Int
  productId Int
  quantity Int
  /// Unidades entregadas de verdad al cliente. La diferencia con quantity es
  /// lo que quedo pendiente: se vendio pero aun no hay mercaderia en la tienda
  /// y esta en camino desde el almacen.
  deliveredQuantity Int     @default(0)
  unitPrice Decimal
  subtotal Decimal
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Solicitudes abiertas que estan traeniendo estas unidades faltantes.
  requests  ProductRequest[]

  @@index([productId])
  // Cada renglon se busca por su venta: es el cruce que hace el dashboard
  // al agrupar unidades y totales.
  @@index([saleId])
}

model Payment {
  id     Int           @id @default(autoincrement())
  saleId Int
  method PaymentMethod
  amount Decimal
  date   DateTime      @default(now())
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Agrupar los pagos por metodo exige cruzar cada uno con su venta.
  @@index([saleId])
}

model Return {
  id        Int           @id @default(autoincrement())
  saleId    Int
  productId Int
  reason    String
  quantity  Int
  amount    Decimal
  method    PaymentMethod
  date      DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
  sale      Sale          @relation(fields: [saleId], references: [id])
}

model Movement {
  id             Int             @id @default(autoincrement())
  productId      Int
  fromLocationId Int
  toLocationId   Int
  quantity       Int
  userId         Int
  requestId      Int?
  requester      String?
  date           DateTime        @default(now())
  observation    String?
  fromLocation   Location        @relation("MovementFrom", fields: [fromLocationId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  toLocation     Location        @relation("MovementTo", fields: [toLocationId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  request        ProductRequest? @relation(fields: [requestId], references: [id])

  // El historial siempre se ordena por fecha descendente y el dashboard
  // toma los ultimos 10 movimientos.
  @@index([date])
}

model ProductRequest {
  id             Int              @id @default(autoincrement())
  productId      Int
  quantity       Int
  requestedById  Int
  locationId     Int
  fromLocationId Int?
  confirmedById  Int?
  confirmedAt    DateTime?
  despatchNoteId Int?
  /// Venta que origino la solicitud cuando se genero por stock faltante al
  /// vender. Permite completar la venta cuando la mercaderia llega.
  saleId        Int?
  saleItemId    Int?
  source         String           @default("MANUAL")
  status         RequestStatus    @default(PENDIENTE)
  note           String?
  expectedDate   DateTime?
  date           DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  location       Location         @relation("RequestDestination", fields: [locationId], references: [id])
  fromLocation   Location?        @relation("RequestOrigin", fields: [fromLocationId], references: [id])
  product        Product          @relation(fields: [productId], references: [id])
  requestedBy    User             @relation("RequestedBy", fields: [requestedById], references: [id])
  confirmedBy    User?            @relation("RequestConfirmedBy", fields: [confirmedById], references: [id])
  despatchNote   DespatchNote?    @relation(fields: [despatchNoteId], references: [id])
  sale           Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItem       SaleItem?        @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  history        RequestHistory[]
  movements      Movement[]

  // Se busca por venta para saber que pedido cierra cada solicitud cuando
  // llega la mercaderia.
  @@index([saleId])
  @@index([saleItemId])
  // Pedidos pendientes, ordenados por fecha de creacion.
  @@index([status, createdAt])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
}

model Cost {
  id           Int      @id @default(autoincrement())
  productId    Int
  supplierId   Int
  invoiceUrl   String?
  exchangeRate Decimal?
  costPrice    Decimal
  percentage   Decimal?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
}

model PurchaseNote {
  id              Int                @id @default(autoincrement())
  noteNumber      String             @unique
  date            DateTime           @default(now())
  supplierName    String
  supplierNit     String?
  supplierPhone   String?
  locationId      Int
  fileUrl         String?
  exchangeRate    Decimal?
  expensesPer     Decimal?
  totalUnits      Int                @default(0)
  totalCost       Decimal            @default(0)
  userId          Int
  status          PurchaseNoteStatus @default(ACTIVA)
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  location        Location           @relation(fields: [locationId], references: [id])
  user            User               @relation("PurchaseNoteUser", fields: [userId], references: [id])
  items           PurchaseNoteItem[]

  @@index([locationId])
}

model PurchaseNoteItem {
  id        Int          @id @default(autoincrement())
  noteId    Int
  productId Int
  quantity  Int
  unitCost  Decimal
  price1    Decimal?
  price2    Decimal?
  disc20    Decimal?
  disc30    Decimal?
  disc40    Decimal?
  disc50    Decimal?
  priceD20  Decimal?
  priceD30  Decimal?
  priceD40  Decimal?
  priceD50  Decimal?
  lineTotal Decimal
  product   Product      @relation(fields: [productId], references: [id])
  note      PurchaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([productId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DespatchNote {
  id              Int                @id @default(autoincrement())
  noteNumber      String             @unique
  date            DateTime           @default(now())
  userId          Int
  totalUnits      Int                @default(0)
  destinationId   Int?
  status          DespatchNoteStatus @default(EMITIDA)
  entregadoA      String?
  entregadoAt     DateTime?
  observacion     String?
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation("DespatchNoteUser", fields: [userId], references: [id])
  destination     Location?          @relation("DespatchNoteDestination", fields: [destinationId], references: [id])
  items           DespatchNoteItem[]
  requests        ProductRequest[]
}

model DespatchNoteItem {
  id           Int          @id @default(autoincrement())
  noteId       Int
  productId    Int
  itemCode     String
  name         String
  manufacturer String
  brand        String
  model        String
  locationId   Int
  locationName String
  locationType String
  quantity     Int
  createdAt    DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id])
  note         DespatchNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([productId])
}

model Manufacturer {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Importer {
  id          Int               @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  logo        String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductImporter[]
}

model ProductImporter {
  id         Int      @id @default(autoincrement())
  productId  Int
  importerId Int
  importer   Importer @relation(fields: [importerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, importerId])
}

enum Role {
  ADMIN
  TIENDA
  INVENTARIO
}

enum LocationType {
  ALMACEN
  TIENDA
}

enum SaleStatus {
  PENDIENTE
  PAGADO
}

enum SaleType {
  NORMAL
  MAYOR
  DEPARTAMENTAL
}

enum PaymentMethod {
  EFECTIVO
  QR
  TRANSFERENCIA
  CREDITO
}

enum PurchaseNoteStatus {
  ACTIVA
  ANULADA
}

enum DespatchNoteStatus {
  EMITIDA
  ENTREGADA
  ANULADA
}

enum RequestStatus {
  PENDIENTE
  RECIBIDO_POR_INVENTARIO
  PREPARANDO
  ENTREGADO
  RECIBIDO_POR_TIENDA
  CANCELADO
}

model RequestHistory {
  id             Int            @id @default(autoincrement())
  requestId      Int
  previousStatus String?
  newStatus      String
  userId         Int
  userRole       String
  createdAt      DateTime       @default(now())
  request        ProductRequest @relation(fields: [requestId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  targetType String
  targetId   Int?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
