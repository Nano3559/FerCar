generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoleModel {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  permissions     String[]
  columnConfig    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  roleId       Int
  locationId   Int?
  columnPrefs  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  movements    Movement[]
  requests     ProductRequest[] @relation("RequestedBy")
  sales        Sale[]
  location     Location?        @relation(fields: [locationId], references: [id])
  role         RoleModel        @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]
  notifications Notification[]
  purchaseNotes PurchaseNote[] @relation("PurchaseNoteUser")
}

model Location {
  id            Int              @id @default(autoincrement())
  name          String
  type          LocationType
  address       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  inventories   Inventory[]
  movementsFrom Movement[]       @relation("MovementFrom")
  movementsTo   Movement[]       @relation("MovementTo")
  requests      ProductRequest[]
  salesFrom     Sale[]           @relation("SaleFromLocation")
  users         User[]
  purchaseNotes PurchaseNote[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             Int               @id @default(autoincrement())
  itemCode       String            @unique
  manufacturer   String
  name           String
  brand          String
  model          String
  year           String
  detail         String?
  oemCode        String?
  factoryCode    String?
  image          String?
  images         String[]       @default([])
  price1         Decimal
  price2         Decimal
  wholesalePrice Decimal?
  cost           Decimal?
  categoryId     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  detalles       String?
  costs          Cost[]
  inventories    Inventory[]
  movements      Movement[]
  category       Category?         @relation(fields: [categoryId], references: [id])
  importers      ProductImporter[]
  requests       ProductRequest[]
  returns        Return[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseNoteItem[]
}

model Inventory {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  stock      Int      @default(0)
  minStock   Int      @default(1)
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id           Int        @id @default(autoincrement())
  saleDate     DateTime   @default(now())
  total        Decimal
  type         SaleType
  userId       Int
  locationId   Int
  customerId   Int?
  seller       String?
  paraQuien    String?
  lugarEntrega String?
  datosFactura String?
  formaPago    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payments     Payment[]
  returns      Return[]
  customer     Customer?  @relation(fields: [customerId], references: [id])
  location     Location   @relation("SaleFromLocation", fields: [locationId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  items        SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Payment {
  id     Int           @id @default(autoincrement())
  saleId Int
  method PaymentMethod
  amount Decimal
  date   DateTime      @default(now())
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id        Int           @id @default(autoincrement())
  saleId    Int
  productId Int
  reason    String
  quantity  Int
  amount    Decimal
  method    PaymentMethod
  date      DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
  sale      Sale          @relation(fields: [saleId], references: [id])
}

model Movement {
  id             Int      @id @default(autoincrement())
  productId      Int
  fromLocationId Int
  toLocationId   Int
  quantity       Int
  userId         Int
  requestId      Int?
  date           DateTime @default(now())
  observation    String?
  fromLocation   Location @relation("MovementFrom", fields: [fromLocationId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
  toLocation     Location @relation("MovementTo", fields: [toLocationId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  request        ProductRequest? @relation(fields: [requestId], references: [id])
}

model ProductRequest {
  id            Int           @id @default(autoincrement())
  productId     Int
  quantity      Int
  requestedById Int
  locationId    Int
  status        RequestStatus @default(PENDIENTE)
  note          String?
  expectedDate  DateTime?
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  location      Location      @relation(fields: [locationId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  requestedBy   User          @relation("RequestedBy", fields: [requestedById], references: [id])
  history       RequestHistory[]
  movements     Movement[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  nit       String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costs     Cost[]
}

model Cost {
  id           Int      @id @default(autoincrement())
  productId    Int
  supplierId   Int
  invoiceUrl   String?
  exchangeRate Decimal?
  costPrice    Decimal
  percentage   Decimal?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
}

model PurchaseNote {
  id            Int                @id @default(autoincrement())
  noteNumber    String             @unique
  date          DateTime           @default(now())
  supplierName  String
  supplierNit   String?
  supplierPhone String?
  locationId    Int
  fileUrl       String?
  exchangeRate  Decimal?
  expensesPer   Decimal?
  totalUnits    Int                @default(0)
  totalCost     Decimal            @default(0)
  userId        Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  location      Location           @relation(fields: [locationId], references: [id])
  user          User               @relation("PurchaseNoteUser", fields: [userId], references: [id])
  items         PurchaseNoteItem[]

  @@index([locationId])
}

model PurchaseNoteItem {
  id        Int          @id @default(autoincrement())
  noteId    Int
  productId Int
  quantity  Int
  unitCost  Decimal
  price1    Decimal?
  price2    Decimal?
  disc20    Decimal?
  disc30    Decimal?
  disc40    Decimal?
  disc50    Decimal?
  priceD20  Decimal?
  priceD30  Decimal?
  priceD40  Decimal?
  priceD50  Decimal?
  lineTotal Decimal
  product   Product      @relation(fields: [productId], references: [id])
  note      PurchaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([productId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Importer {
  id          Int               @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  logo        String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductImporter[]
}

model ProductImporter {
  id         Int      @id @default(autoincrement())
  productId  Int
  importerId Int
  importer   Importer @relation(fields: [importerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, importerId])
}

enum Role {
  ADMIN
  TIENDA
  INVENTARIO
}

enum LocationType {
  ALMACEN
  TIENDA
}

enum SaleType {
  NORMAL
  MAYOR
}

enum PaymentMethod {
  EFECTIVO
  QR
  TRANSFERENCIA
  CREDITO
}

enum RequestStatus {
  PENDIENTE
  RECIBIDO_POR_INVENTARIO
  PREPARANDO
  ENTREGADO
  RECIBIDO_POR_TIENDA
  CANCELADO
}

model RequestHistory {
  id            Int            @id @default(autoincrement())
  requestId     Int
  previousStatus String?
  newStatus     String
  userId        Int
  userRole      String
  createdAt     DateTime       @default(now())
  request       ProductRequest @relation(fields: [requestId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  targetType  String
  targetId    Int?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
